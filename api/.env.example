# SiftRate API environment.
# Copy this file to `api/.env`.
# Every variable below is validated at boot by the zod schema in
# `src/app/config/env.config.ts` — a missing or invalid value crashes startup.

# --- Core ---
PORT=5000
NODE_ENV=development
# Public URL of the web app; used for CORS.
ORIGIN=http://localhost:3000

DATABASE_URL=postgres://siftrate:change-me@localhost:5432/siftrate
REDIS_URL=redis://localhost:6379

# --- Sessions ---
# Must be at least 32 characters long.
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
SESSION_PREFIX=sessions:

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Media metadata providers ---
# TMDB (movies, TV shows): https://developer.themoviedb.org
TMDB_API_KEY=
# OMDb (ratings): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# IGDB (games): https://api-docs.igdb.com
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Google Books: https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=
# TinyFish (metadata scraping): https://tinyfish.ai
TINYFISH_API_KEY=
# Spotify (albums, tracks): https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- S3 / MinIO ---
# Inside Docker Compose these are overridden to point at the `minio` service.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=siftrate
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=siftrate
S3_SECRET_ACCESS_KEY=change-me
# Public base URL used to build poster URLs.
S3_PUBLIC_BASE_URL=http://localhost:9000/siftrate
