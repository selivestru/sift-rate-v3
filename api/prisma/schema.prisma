generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  MOVIE
  TV_SHOW
  GAME
  BOOK
  ALBUM
  TRACK
}

enum MediaLanguage {
  EN
  UK
  RU
}

model User {
  id          String   @id @default(uuid(7))
  email       String
  username    String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews      Review[]
  plannedItems PlannedItem[]
  rankedLists  RankedList[]
  importJobs   ImportJob[]

  @@unique([email])
  @@unique([username])
}

model Media {
  id         String    @id @default(uuid(7))
  externalId String
  mediaType  MediaType
  title      String
  posterUrl  String?
  metadata   Json?

  translations MediaTranslation[]
  reviews      Review[]
  plannedItems PlannedItem[]
  rankedItems  RankedItem[]

  @@unique([externalId, mediaType])
  @@unique([id, mediaType])
  @@index([mediaType])
}

model MediaTranslation {
  mediaId   String
  mediaType MediaType
  language  MediaLanguage
  title     String?
  posterUrl String?
  updatedAt DateTime      @default(now()) @updatedAt

  media Media @relation(fields: [mediaId, mediaType], references: [id, mediaType], onDelete: Cascade, onUpdate: Restrict)

  @@id([mediaId, language])
}

model Review {
  id        String   @id @default(uuid(7))
  userId    String
  mediaId   String
  rating    Int
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId, createdAt])
  @@index([mediaId, createdAt(sort: Desc), id(sort: Desc)])
}

model PlannedItem {
  id        String   @id @default(uuid(7))
  userId    String
  mediaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model RankedList {
  id        String   @id @default(uuid(7))
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items RankedItem[]
}

model RankedItem {
  id        String   @id @default(uuid(7))
  listId    String
  mediaId   String
  position  Int
  createdAt DateTime @default(now())

  list  RankedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  media Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId])
  @@index([listId, position])
}

enum ImportSource {
  IMDB
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  PENDING
  CREATED
  SKIPPED_EXISTING
  SKIPPED_TYPE
  NOT_FOUND
  INVALID
  ERROR
}

model ImportJob {
  id              String          @id @default(uuid(7))
  userId          String
  source          ImportSource
  status          ImportJobStatus
  total           Int
  processed       Int             @default(0)
  createdCount    Int             @default(0)
  skippedExisting Int             @default(0)
  skippedType     Int             @default(0)
  notFound        Int             @default(0)
  invalid         Int             @default(0)
  errorCount      Int             @default(0)
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  finishedAt      DateTime?

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows ImportJobRow[]

  @@index([userId, status])
}

model ImportJobRow {
  id        String          @id @default(uuid(7))
  jobId     String
  position  Int             @default(0)
  imdbId    String
  rating    Int?
  ratedAt   DateTime?
  title     String
  titleType String
  status    ImportRowStatus
  error     String?

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, position])
  @@index([jobId, status])
}
