generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  CREDENTIALS
  GOOGLE
}

enum Subscription {
  FREE
  MONTHLY
  YEARLY
  LIFETIME
}

enum MediaType {
  MOVIE
  TV_SHOW
  GAME
  BOOK
  ALBUM
  TRACK
}

enum Visibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

model User {
  id               String       @id @default(uuid(7))
  email            String
  displayName      String
  username         String?
  passwordHash     String?
  avatarUrl        String?
  method           AuthMethod   @default(CREDENTIALS)
  subscription     Subscription @default(FREE)
  isVerified       Boolean      @default(false)
  twoFactorEnabled Boolean      @default(false)
  twoFactorSecret  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  reviews      Review[]
  plannedItems PlannedItem[]
  rankedLists  RankedList[]

  @@unique([email])
  @@unique([username])
}

model Media {
  id         String    @id @default(uuid(7))
  externalId String
  mediaType  MediaType
  title      String
  posterUrl  String?
  watchUrl   String?

  reviews      Review[]
  plannedItems PlannedItem[]
  rankedItems  RankedItem[]

  @@unique([externalId, mediaType])
}

model Review {
  id         String     @id @default(uuid(7))
  userId     String
  mediaId    String
  rating     Int
  content    String?
  visibility Visibility @default(PRIVATE)
  hasSpoiler Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model PlannedItem {
  id        String   @id @default(uuid(7))
  userId    String
  mediaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model RankedList {
  id         String     @id @default(uuid(7))
  userId     String
  title      String
  visibility Visibility @default(PRIVATE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items RankedItem[]
}

model RankedItem {
  id        String   @id @default(uuid(7))
  listId    String
  mediaId   String
  position  Int
  createdAt DateTime @default(now())

  list  RankedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  media Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId])
  @@index([listId, position])
}
