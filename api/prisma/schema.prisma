generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  CREDENTIALS
  GOOGLE
}

enum Subscription {
  FREE
  MONTHLY
  YEARLY
  LIFETIME
}

enum MediaType {
  MOVIE
  TV_SHOW
  GAME
  BOOK
  ALBUM
  TRACK
}

enum ReviewVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

model User {
  id           String       @id @default(uuid(7))
  email        String
  username     String?
  passwordHash String?
  method       AuthMethod   @default(CREDENTIALS)
  subscription Subscription @default(FREE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([email])
  @@unique([username])
}
