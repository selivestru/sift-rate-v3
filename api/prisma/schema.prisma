generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  MOVIE
  TV_SHOW
  GAME
  BOOK
  ALBUM
  TRACK
}

model User {
  id        String   @id @default(uuid(7))
  username  String?  @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
