generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  MOVIE
  TV_SHOW
  GAME
  BOOK
  ALBUM
  TRACK
}

model User {
  id          String   @id @default(uuid(7))
  email       String
  displayName String?
  username    String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews      Review[]
  plannedItems PlannedItem[]
  rankedLists  RankedList[]

  @@unique([email])
  @@unique([username])
}

model Media {
  id         String    @id @default(uuid(7))
  externalId String
  mediaType  MediaType
  title      String
  posterUrl  String?
  metadata   Json?

  reviews      Review[]
  plannedItems PlannedItem[]
  rankedItems  RankedItem[]

  @@unique([externalId, mediaType])
  @@index([mediaType])
}

model Review {
  id        String   @id @default(uuid(7))
  userId    String
  mediaId   String
  rating    Int
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId, createdAt])
  @@index([mediaId, createdAt(sort: Desc), id(sort: Desc)])
}

model PlannedItem {
  id        String   @id @default(uuid(7))
  userId    String
  mediaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model RankedList {
  id        String   @id @default(uuid(7))
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items RankedItem[]
}

model RankedItem {
  id        String   @id @default(uuid(7))
  listId    String
  mediaId   String
  position  Int
  createdAt DateTime @default(now())

  list  RankedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  media Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId])
  @@index([listId, position])
}
