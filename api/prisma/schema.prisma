generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  CREDENTIALS
  GOOGLE
}

enum Subscription {
  FREE
  MONTHLY
  YEARLY
  LIFETIME
}

enum MediaType {
  MOVIE
  TV_SHOW
  GAME
  BOOK
  ALBUM
  TRACK
}

enum AchievementRarity {
  COMMON
  RARE
  LEGENDARY
}

model User {
  id               String       @id @default(uuid(7))
  email            String
  displayName      String?
  username         String?
  passwordHash     String?
  avatarUrl        String?
  method           AuthMethod   @default(CREDENTIALS)
  subscription     Subscription @default(FREE)
  isVerified       Boolean      @default(false)
  twoFactorEnabled Boolean      @default(false)
  twoFactorSecret  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  following Follow[] @relation("Follower")
  followers Follow[] @relation("Following")

  reviews      Review[]
  plannedItems PlannedItem[]
  rankedLists  RankedList[]
  posts        Post[]

  @@unique([email])
  @@unique([username])
}

model Follow {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())

  followerId String
  follower   User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Media {
  id         String    @id @default(uuid(7))
  externalId String
  mediaType  MediaType
  title      String
  posterUrl  String?
  metadata   Json?

  reviews      Review[]
  plannedItems PlannedItem[]
  rankedItems  RankedItem[]

  @@unique([externalId, mediaType])
  @@index([mediaType])
}

model Review {
  id        String   @id @default(uuid(7))
  userId    String
  mediaId   String
  rating    Int
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  post  Post?

  @@unique([userId, mediaId])
  @@index([userId, createdAt])
  @@index([mediaId, createdAt(sort: Desc), id(sort: Desc)])
}

model PlannedItem {
  id        String   @id @default(uuid(7))
  userId    String
  mediaId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
}

model RankedList {
  id        String   @id @default(uuid(7))
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items RankedItem[]
}

model RankedItem {
  id        String   @id @default(uuid(7))
  listId    String
  mediaId   String
  position  Int
  createdAt DateTime @default(now())

  list  RankedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  media Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId])
  @@index([listId, position])
}

model Post {
  id        String   @id @default(uuid(7))
  content   String?
  userId    String
  reviewId  String?  @unique
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
}
