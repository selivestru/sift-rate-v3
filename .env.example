# Infrastructure environment for local Docker Compose (docker-compose.yml).
# Copy this file to `.env` in the repository root.

# Postgres (service `db`)
POSTGRES_USER="siftrate"
POSTGRES_DB="siftrate"
POSTGRES_PASSWORD="change-me"

# MinIO — S3-compatible object storage (service `minio`)
MINIO_ROOT_USER="siftrate"
MINIO_ROOT_PASSWORD="change-me"
